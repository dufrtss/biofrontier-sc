# Supabase — community contributions layer.
#
# Both values are public: NEXT_PUBLIC_ variables are inlined into the browser
# bundle. The anon key identifies the project and nothing more; Row Level
# Security is what protects the data (see supabase/migrations).
#
# Never put the service_role key here or in any NEXT_PUBLIC_ variable — it
# bypasses RLS entirely.
#
# Leave both unset and the app runs without the community layer: the map,
# ranking and methodology panel all work, and the contribution UI is hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend SMTP credential, read by `supabase config push` via env() in
# supabase/config.toml. Not needed to run the app — only to push auth config.
# Create a send-only key at resend.com/api-keys.
RESEND_API_KEY=
